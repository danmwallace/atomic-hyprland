# Paths an earlier image wrote into $HOME that this image no longer ships.
# sync-dotfiles removes them on the next stamp change. A trailing / removes
# the directory. Only image-written paths belong here, never local* files.
# The role's waybar (the image reads config.jsonc; waybar would prefer `config`).
.config/waybar/config
.config/waybar/mediaplayer.py
# The role's split wofi stylesheets, helper script, portal file and the two nwg tools.
.config/wofi/style-power.css
.config/wofi/style-run.css
.config/hypr/scripts/sleep.sh
.config/hypr/xdg-portal-hyprland
.config/hypr/conf/
.config/nwg-drawer/
.config/nwg-dock-hyprland/
