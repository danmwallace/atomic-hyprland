# The user's files. sync-dotfiles creates each from skel/ once if it is
# absent and never writes it again. Later tasks append their local files.
.config/hypr/local.lua
.config/waybar/local.jsonc
.config/waybar/local.css
.config/swaync/local.css
.config/hypr/hypridle.local.conf
.config/wofi/local.css
.config/hypr/hyprlock.local.conf
.config/ghostty/local
.config/alacritty/local.toml
.config/btop/btop.conf
.config/elvish/rc.elv
.config/helix/config.toml
# Flatpak apps see /usr/share/fonts as /run/host/fonts, remapped to
# /usr/share/fonts: the same fontconfig cache key as the runtime's own fonts.
# On an ostree host both directories have mtime 0, so the runtime's cache
# always validates and the host's fonts (the Nerd Fonts, Inter) never load.
# This link sits in ~/.local/share/fonts (/run/host/user-fonts in the sandbox)
# and gives the host fonts a path of their own. Dangling, so ignored, on the host.
.local/share/fonts/host-fonts
