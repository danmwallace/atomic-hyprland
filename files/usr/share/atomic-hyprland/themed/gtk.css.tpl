/* Rendered by hypr-theme; ~/.config/gtk-3.0/gtk.css and gtk-4.0/gtk.css link here.
   libadwaita's named colours, from the theme: GTK4 apps read them directly, and
   GTK3 apps (and Chromium in GTK mode) through the adw-gtk3-dark theme, which
   hypr-theme selects. Anything not named here comes from adw-gtk3 / Adwaita. */
@define-color window_bg_color {{ background }};
@define-color window_fg_color {{ foreground }};
@define-color view_bg_color {{ background_alt }};
@define-color view_fg_color {{ foreground }};
@define-color headerbar_bg_color {{ background_alt }};
@define-color headerbar_fg_color {{ foreground }};
@define-color card_bg_color {{ surface }};
@define-color popover_bg_color {{ background_alt }};
@define-color sidebar_bg_color {{ background_alt }};
@define-color accent_color {{ accent }};
@define-color accent_bg_color {{ accent }};
@define-color accent_fg_color {{ background }};
