<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- hypr-agent's root helper. Each use follows an approval card; the password is
     then asked once and kept for a few minutes (auth_admin_keep). A machine owner
     can relax this with a rule in /etc/polkit-1/rules.d. -->
<policyconfig>
  <vendor>atomic-hyprland</vendor>
  <action id="org.atomic-hyprland.agent.root">
    <description>Let the desktop agent change the system</description>
    <message>The desktop agent wants to change the system (you approved this step). Authentication is required.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/atomic-hyprland/agent-root</annotate>
  </action>
</policyconfig>
