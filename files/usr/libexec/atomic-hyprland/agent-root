#!/usr/bin/python3 -I
"""Root helper for hypr-agent: a fixed set of operations, run via pkexec.

  agent-root unit {start|stop|restart} <unit>
  agent-root bootc-upgrade                      stage only, never --apply
  agent-root bootc-rollback
  agent-root etc-snapshot <session-dir> <path>  save /etc/<path> for undo
  agent-root etc-write <session-dir> <path>     snapshot, then write stdin
  agent-root etc-restore <path> <copy|->        undo: restore (or remove)

Allowlists, not denylists: only the units in ALLOWED_UNITS (plus one name per
line in /etc/atomic-hyprland/agent-units, root-owned), judged by the name they
resolve to; only the /etc files in ETC_ALLOWED, world-readable, with no '..' or
symlinks on the way. Session folders and snapshot copies must belong to the
user who ran pkexec (PKEXEC_UID).
Exit 0 ok, 1 the operation failed, 2 refused. Standalone on purpose: it
imports nothing from the user-side atomic_agent package.
"""
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile

ETC = "/etc"
UNIT = re.compile(r"[A-Za-z0-9@._:\-]+\.(service|timer|socket|path)")
UNITS_FILE = "/etc/atomic-hyprland/agent-units"
UNITS_FILE_OWNER = 0  # ignored unless root-owned and not group/world-writable
# Everyday services an agent may restart while fixing something. A machine adds
# its own (Ollama, a Quadlet) to UNITS_FILE.
ALLOWED_UNITS = {
    "tailscaled.service", "cups.service", "cups.socket", "bluetooth.service", "NetworkManager.service",
    "sshd.service", "tuned.service", "avahi-daemon.service", "fwupd.service", "podman.socket",
    "bootc-fetch-apply-updates.service", "bootc-fetch-apply-updates.timer", "ai-images-pull.service",
}
# The /etc files an agent may write. Kept to files whose content cannot point a
# root daemon at code or paths the user controls (tuned profiles run scripts,
# daemon configs choose remotes and plugins). A machine owner adds more, one
# path relative to /etc per line, in ETC_FILE (root-owned). Everything else is a
# PR to the image or a command for the user to run.
ETC_ALLOWED = ("hosts",)
ETC_FILE = "/etc/atomic-hyprland/agent-etc"
# Never writable through the helper, whatever ETC_FILE says: the helper's own
# lists and the agent's config.
ETC_NEVER = ("atomic-hyprland/",)


class Refused(Exception):
    pass


def home_of(uid: int) -> str:
    return pwd.getpwuid(uid).pw_dir


def _under(path: str, root: str) -> bool:
    return path == root or path.startswith(root.rstrip("/") + "/")


def _root_list(path: str) -> set[str]:
    """Lines of a root-owned, not group/world-writable list file; empty otherwise."""
    try:
        st = os.stat(path)
        if st.st_uid == UNITS_FILE_OWNER and not st.st_mode & 0o022:
            with open(path) as f:
                return {l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")}
    except OSError:
        pass
    return set()


def allowed_units() -> set[str]:
    return ALLOWED_UNITS | _root_list(UNITS_FILE)


def validate_unit(unit: str, run=subprocess.run) -> str:
    if not UNIT.fullmatch(unit):
        raise Refused(f"not a service, timer, socket or path unit: {unit!r}")
    resolved = run(["systemctl", "show", "-p", "Id", "--value", unit],
                   capture_output=True, text=True).stdout.strip() or unit
    allowed = allowed_units()
    for name in {unit, resolved}:
        if name not in allowed:
            raise Refused(f"{name!r} is not on the agent's unit list ({UNITS_FILE} adds more)")
    return unit


def validate_etc_path(path: str) -> str:
    if not os.path.isabs(path) or "\0" in path:
        raise Refused(f"not an absolute path: {path!r}")
    parent, name = os.path.split(path)
    if name in ("", ".", ".."):
        raise Refused(f"not a file path: {path!r}")
    real_parent = os.path.realpath(parent)
    if not _under(real_parent, ETC):
        raise Refused(f"outside {ETC}: {path!r}")
    final = os.path.join(real_parent, name)
    if os.path.islink(final):
        raise Refused(f"refusing to write through a symlink: {path!r}")
    rel = os.path.relpath(final, ETC)
    if any(rel == n or (n.endswith("/") and rel.startswith(n)) for n in ETC_NEVER):
        raise Refused(f"the agent's own configuration: {path!r}")
    allowed = set(ETC_ALLOWED) | _root_list(ETC_FILE)
    if not any(rel == a or (a.endswith("/") and rel.startswith(a) and "/" not in rel[len(a):])
               for a in allowed):
        raise Refused(f"not on the agent's /etc list ({ETC_FILE} adds more): {path!r}")
    if os.path.exists(final) and not os.stat(final).st_mode & 0o004:
        # Snapshots land in the user's folder; never copy out what the user cannot read.
        raise Refused(f"not world-readable: {path!r}")
    return final


def validate_user_path(path: str, uid: int, want_dir: bool) -> str:
    real = os.path.realpath(path)
    home = os.path.realpath(home_of(uid))
    if not _under(real, home) or real == home:
        raise Refused(f"not in the user's home: {path!r}")
    try:
        st = os.stat(real)
    except OSError as exc:
        raise Refused(f"{path!r}: {exc}") from exc
    if st.st_uid != uid:
        raise Refused(f"not owned by uid {uid}: {path!r}")
    if want_dir != os.path.isdir(real):
        raise Refused(f"{'not a folder' if want_dir else 'not a file'}: {path!r}")
    return real


def read_user_file(path: str, uid: int) -> bytes:
    """Read a snapshot copy without following a symlink swapped in after the check."""
    import stat
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        st = os.fstat(fd)
        if st.st_uid != uid or not stat.S_ISREG(st.st_mode):
            raise Refused(f"not a regular file owned by uid {uid}: {path!r}")
        with os.fdopen(fd, "rb", closefd=False) as f:
            return f.read()
    finally:
        os.close(fd)


def as_user(uid: int, gid: int, fn) -> int:
    """Run fn in a child process with the user's uid/gid, so nothing written into the
    user's folder (copies, manifest) can follow a symlink with root's rights."""
    pid = os.fork()
    if pid == 0:
        code = 1
        try:
            if os.geteuid() == 0:
                os.setgroups([])
            os.setresgid(gid, gid, gid)
            os.setresuid(uid, uid, uid)
            fn()
            code = 0
        except Refused as exc:
            print(f"agent-root: refused: {exc}", file=sys.stderr)
            code = 2
        except BaseException as exc:  # noqa: BLE001 - the child must always exit
            print(f"agent-root: {exc}", file=sys.stderr)
        finally:
            os._exit(code)
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


def _no_symlink(path: str) -> None:
    if os.path.islink(path):
        raise Refused(f"symlink in the session folder: {path!r}")


def _entries(sdir: str) -> list[dict]:
    m = os.path.join(sdir, "manifest.jsonl")
    _no_symlink(m)
    try:
        fd = os.open(m, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return []
    with os.fdopen(fd) as f:
        return [json.loads(line) for line in f if line.strip()]


def _append(sdir: str, entry: dict) -> None:
    m = os.path.join(sdir, "manifest.jsonl")
    _no_symlink(m)
    fd = os.open(m, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(json.dumps(entry) + "\n")


def _user_snapshot(sdir: str, path: str, data: bytes | None) -> None:
    """Same manifest format as atomic_agent.snapshots.snapshot. Runs as the user."""
    entries = _entries(sdir)
    if any(e.get("path") == path and "existed" in e for e in entries):
        return
    files = os.path.join(sdir, "files")
    _no_symlink(files)
    os.makedirs(files, exist_ok=True)
    if data is not None:
        copy = f"files/{sum(1 for e in entries if 'existed' in e)}"
        fd = os.open(os.path.join(sdir, copy), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        _append(sdir, {"path": path, "existed": True, "copy": copy})
    else:
        _append(sdir, {"path": path, "existed": False, "copy": None})


def snapshot(sdir: str, path: str, uid: int, gid: int) -> int:
    data = None
    if os.path.exists(path):
        with open(path, "rb") as f:  # read as root: validate_etc_path checked it is world-readable
            data = f.read()
    return as_user(uid, gid, lambda: _user_snapshot(sdir, path, data))


def mark_applied(sdir: str, path: str, uid: int, gid: int) -> int:
    return as_user(uid, gid, lambda: _append(sdir, {"event": "applied", "path": path}))


def write_file(path: str, data: bytes) -> None:
    """Replace path atomically, keeping its mode, owner and SELinux label."""
    old = os.stat(path) if os.path.exists(path) else None
    label = None
    if old is not None:
        try:
            label = os.getxattr(path, "security.selinux")
        except OSError:
            label = None
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".agent-root.")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(tmp, old.st_mode & 0o7777 if old else 0o644)
        if old is not None:
            os.chown(tmp, old.st_uid, old.st_gid)
        if label:
            os.setxattr(tmp, "security.selinux", label)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def main(argv, env=os.environ, run=subprocess.run, stdin=sys.stdin) -> int:
    try:
        if not argv:
            raise Refused("no operation")
        op, args = argv[0], argv[1:]
        if op == "unit" and len(args) == 2 and args[0] in ("start", "stop", "restart"):
            return run(["systemctl", args[0], validate_unit(args[1], run)]).returncode and 1
        if op == "bootc-upgrade" and not args:
            return run(["bootc", "upgrade"]).returncode and 1
        if op == "bootc-rollback" and not args:
            return run(["bootc", "rollback"]).returncode and 1
        uid = int(env.get("PKEXEC_UID", "-1"))
        if uid < 0:
            raise Refused("PKEXEC_UID is not set")
        if op in ("etc-snapshot", "etc-write") and len(args) == 2:
            sdir = validate_user_path(args[0], uid, want_dir=True)
            path = validate_etc_path(args[1])
            gid = pwd.getpwuid(uid).pw_gid
            rc = snapshot(sdir, path, uid, gid)
            if rc != 0:
                return rc
            if op == "etc-write":
                write_file(path, stdin.read().encode())
                return mark_applied(sdir, path, uid, gid)
            return 0
        if op == "etc-restore" and len(args) == 2:
            path = validate_etc_path(args[0])
            if args[1] == "-":
                if os.path.lexists(path):
                    os.unlink(path)
                return 0
            copy = validate_user_path(args[1], uid, want_dir=False)
            write_file(path, read_user_file(copy, uid))
            return 0
        raise Refused(f"unknown operation: {' '.join(argv)!r}")
    except Refused as exc:
        print(f"agent-root: refused: {exc}", file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"agent-root: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
