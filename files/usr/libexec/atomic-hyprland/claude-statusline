#!/usr/bin/python3 -I
"""Claude Code status line: caches plan usage for the waybar widget.

Claude Code pipes its status line JSON to this command (statusLine in
~/.claude/settings.json; claude-statusline-setup adds it once per user). For
Pro/Max plans that JSON carries rate_limits.five_hour / seven_day
used_percentage and resets_at (epoch seconds), documented at
https://code.claude.com/docs/en/statusline. They are written to
$XDG_CACHE_HOME/atomic-hyprland/claude-usage.json, waybar is signalled to
re-read it, and a one-line summary is printed for Claude Code's own status bar.
A payload without rate_limits (before a session's first reply) keeps the cache.
"""
import json
import math
import os
import subprocess
import sys
import tempfile
import time


def pct(value):
    return math.floor(value + 0.5)


def main():
    try:
        data = json.loads(sys.stdin.read())
    except ValueError:
        data = None
    if not isinstance(data, dict):
        print("Claude")
        return
    model = (data.get("model") or {}).get("display_name") or ""
    limits = data.get("rate_limits") if isinstance(data.get("rate_limits"), dict) else {}
    windows = {}
    for key in ("five_hour", "seven_day"):
        w = limits.get(key)
        if (isinstance(w, dict) and isinstance(w.get("used_percentage"), (int, float))
                and isinstance(w.get("resets_at"), (int, float))):
            windows[key] = {"used_percentage": w["used_percentage"], "resets_at": int(w["resets_at"])}

    parts = [model] if model else []
    for key, label in (("five_hour", "5h"), ("seven_day", "wk")):
        if key in windows:
            parts.append(f"{label} {pct(windows[key]['used_percentage'])}%")
    print(" · ".join(parts) or "Claude")

    if not windows:
        return
    now = int(os.environ.get("CLAUDE_USAGE_NOW") or time.time())
    cache_dir = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                             "atomic-hyprland")
    os.makedirs(cache_dir, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=cache_dir, prefix=".claude-usage.")
    with os.fdopen(fd, "w") as f:
        json.dump({"updated_at": now, "model": model, **windows}, f)
    os.replace(tmp, os.path.join(cache_dir, "claude-usage.json"))
    subprocess.run(["pkill", "-RTMIN+9", "-x", "waybar"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


if __name__ == "__main__":
    main()
