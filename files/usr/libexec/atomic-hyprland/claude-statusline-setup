#!/usr/bin/python3 -I
"""Offer the image's Claude Code status line once per user (login unit).

If ~/.claude/settings.json has no statusLine, add the one that feeds the
waybar Claude usage widget, keeping every other key. Either way, record that
it was offered and never touch the file again, so a user who removes or
replaces it keeps their choice. A settings.json that is not valid JSON is
left alone and the offer is retried at the next login.
"""
import json
import os
import tempfile

STATUS_LINE = {"type": "command", "command": "/usr/libexec/atomic-hyprland/claude-statusline"}


def main():
    home = os.path.expanduser("~")
    state = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(home, ".local", "state"),
                         "atomic-hyprland")
    marker = os.path.join(state, "claude-statusline-offered")
    if os.path.exists(marker):
        return
    claude_dir = os.path.join(home, ".claude")
    settings_path = os.path.join(claude_dir, "settings.json")
    settings = {}
    if os.path.exists(settings_path):
        try:
            with open(settings_path) as f:
                settings = json.load(f)
        except ValueError:
            return
        if not isinstance(settings, dict):
            return
    if "statusLine" not in settings:
        settings["statusLine"] = STATUS_LINE
        os.makedirs(claude_dir, mode=0o700, exist_ok=True)
        mode = os.stat(settings_path).st_mode & 0o777 if os.path.exists(settings_path) else 0o600
        fd, tmp = tempfile.mkstemp(dir=claude_dir, prefix=".settings.json.")
        with os.fdopen(fd, "w") as f:
            json.dump(settings, f, indent=2)
            f.write("\n")
        os.chmod(tmp, mode)
        os.replace(tmp, settings_path)
    os.makedirs(state, exist_ok=True)
    open(marker, "w").close()


if __name__ == "__main__":
    main()
