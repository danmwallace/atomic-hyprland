[Unit]
Description=Wallpaper (swaybg) from the current theme
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/swaybg -m fill -i %h/.config/atomic-hyprland/current/background
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
