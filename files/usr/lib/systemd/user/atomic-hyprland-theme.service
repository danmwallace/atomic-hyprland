[Unit]
Description=Render the current atomic-hyprland theme before the Wayland session
ConditionPathExists=/usr/share/atomic-hyprland/stamp
After=atomic-hyprland-dotfiles.service
Wants=atomic-hyprland-dotfiles.service
Before=wayland-session-pre@Hyprland.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/atomic-hyprland/ensure-theme

[Install]
WantedBy=wayland-session-pre@Hyprland.target
