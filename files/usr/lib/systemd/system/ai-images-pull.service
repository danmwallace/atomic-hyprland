[Unit]
Description=Pull the Ollama container image (no in-systemd pull cap)
After=network-online.target
Wants=network-online.target
Before=ollama.service

[Service]
Type=oneshot
RemainAfterExit=yes
# podman caps pulls started from inside a container unit at 5 minutes; a
# plain oneshot has no such cap, so a slow first boot still succeeds.
TimeoutStartSec=0
# Only the first boot (or a tag change) touches the registry; an offline boot
# with the image present must not fail this unit or delay graphical.target.
# The tag lives only in ollama.container's Image= (Renovate bumps it there); read
# it at runtime so this unit can never pre-pull a tag the service won't run.
ExecStart=/bin/sh -c 'img=$$(sed -n "s/^Image=//p" /usr/share/containers/systemd/ollama.container); [ -n "$$img" ] && { podman image exists "$$img" || podman pull "$$img"; }'

[Install]
WantedBy=multi-user.target
