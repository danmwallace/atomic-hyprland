{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "timezone": "UTC",
  "schedule": [
    "before 6am on monday"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Digest-pinned build inputs (NAME=image:tag@sha256:...)",
      "managerFilePatterns": [
        "/^build/images\\.env$/"
      ],
      "matchStrings": [
        "(?<depName>[A-Z_]+)=(?<packageName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Claude Code version baked into the image",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "ARG CLAUDE_CODE_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@anthropic-ai/claude-code"
    },
    {
      "customType": "regex",
      "description": "tuios release binary baked into the image",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "ARG TUIOS_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Gaurav-Gosain/tuios",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Quadlet container images",
      "managerFilePatterns": [
        "/^files/usr/share/containers/systemd/.+\\.container$/"
      ],
      "matchStrings": [
        "Image=(?<depName>[^:\\s]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "JetBrainsMono Nerd Font release pinned in the Containerfile (sha256 updated by hand in the same PR)",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "ARG NERD_FONT_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "stablyai/orca release pinned in the Containerfile (sha256 updated by hand in the same PR)",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "ARG ORCA_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "stablyai/orca",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "aome510/spotify-player release pinned in the Containerfile (sha256 updated by hand in the same PR)",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "ARG SPOTIFY_PLAYER_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "aome510/spotify-player",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Base and akmods move together; one PR, one kernel-match verdict",
      "matchFileNames": [
        "build/images.env"
      ],
      "groupName": "ublue base and akmods",
      "pinDigests": true
    },
    {
      "description": "Fedora version bumps (44 -> 45) are a human decision, not a bot's",
      "matchFileNames": [
        "build/images.env"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    }
  ]
}
